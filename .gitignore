# ── Secrets (NUNCA commitear) ─────────────────────────
.env
*.env.*
credentials*.json
# Plantilla sin valores — si debe viajar en el repo (`*.env.*` la atrapaba)
!.env.example

# ── Python ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.pkl

# ── Data (pesado, se regenera) ────────────────────────
data/raw/*.csv
data/api_cache.json
data/dc_params.json

# ── Logs ──────────────────────────────────────────────
logs/
*.log

# ── IDE / OS ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# ── DB backups ────────────────────────────────────────
data/*.dump
data/*.sql

# ── Orchestrator lock ─────────────────────────────────
orchestrator.lock

# ── Claude Code workspace (personal) ─────────────────
.claude/

# ── Estado de Code Atelier (no pertenece al repo) ────
# .pm-state/ es estado del process manager; blueprints/ son el spec,
# plan y tasks que genera la herramienta al construir la rama `main`.
.pm-state/
blueprints/

# Dashboard installer artifacts (el .exe/.msi no se commitea)
installer/build/
installer/dist/
installer/*.wxs
