# =====================================================================
# .env.example — plantilla de configuracion
# =====================================================================
# Copia este archivo a `.env` y rellena los valores. `.env` esta en
# .gitignore y NUNCA se commitea.
#
#     cp .env.example .env
#
# config/settings.py carga `.env` solo (sin python-dotenv). En GitHub
# Actions estas mismas variables van como repository secrets.
#
# Solo DB_URL es obligatoria (settings.py lanza RuntimeError si falta).
# El resto degrada: sin ODDS_API_KEY no hay cuotas, sin TELEGRAM_* no hay
# alertas, sin ANTHROPIC_API_KEY el pre-kickoff analyst sale con warning.
#
# OJO (GitHub Actions): un secret no configurado se expande a "" y
# `int("")` truena. Por eso el codigo usa env_int/env_float/env_str de
# config/settings.py, que caen al default con "" o valor no parseable.
# Si agregas una var numerica nueva, usa esos helpers.
# =====================================================================

# ── OBLIGATORIA: base de datos ───────────────────────────────────────
# Postgres (produccion corre en Neon). Formato SQLAlchemy + psycopg2.
# Apunta a una DB de pruebas si solo vas a explorar: el orchestrator
# escribe en bets_history real y afecta bankroll/ROI/CLV.
DB_URL=postgresql+psycopg2://usuario:password@host/basedatos

# ── The Odds API — cuotas ────────────────────────────────────────────
# https://the-odds-api.com  (plan $30/mes = 20K creditos)
ODDS_API_KEY=
ODDS_REGION=eu                       # 1 sola region = ahorra creditos
ODDS_REGION_MLB=us                   # MLB usa libros de EE.UU.
ODDS_MARKETS=h2h,totals,spreads      # solo "featured"; specialty va por /events/{id}/odds
API_TTL_HOURS=12                     # 2 fetches/dia (morning + evening)
FETCH_DAYS_AHEAD=7
API_CREDITS_ALERT_THRESHOLD=2000     # avisa cuando queden <= N creditos
API_CREDITS_STOP_THRESHOLD=500       # aborta la corrida por debajo de N creditos
MAX_CREDITS_PER_RUN=800              # tope por corrida de update_upcoming_matches
ENRICH_DAYS_AHEAD=2
ENRICH_CACHE_TTL_HOURS=12
MAX_ENRICHMENTS_PER_RUN=

# ── Anthropic — pre-kickoff analyst y resolver de pendientes ─────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_BUDGET_USD=0.20      # guard de gasto diario
PRE_KICKOFF_WINDOW_MIN=30            # ventana en min antes del kickoff
PRE_KICKOFF_WINDOW_MAX=60            # 60 y no 90: alineaciones ya publicadas
ANALYST_EDGE_THRESHOLD=3             # puntos porcentuales para decir APUESTA

# ── Telegram — alertas ───────────────────────────────────────────────
# Token via @BotFather; chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot dedicado del pre-kickoff analyst (cron cada 15 min genera muchos
# SKIPs). Si los dejas vacios, cae al bot principal.
TELEGRAM_BOT_TOKEN_PREKICKOFF=
TELEGRAM_CHAT_ID_PREKICKOFF=

# ── APIs auxiliares ──────────────────────────────────────────────────
WEATHER_API_KEY=                     # OpenWeatherMap, gratis 1000 calls/dia
RAPIDAPI_KEY=                        # solo lo usa test_api.py

# ── Bankroll y zona horaria ──────────────────────────────────────────
INITIAL_BANKROLL=100.0               # solo se usa al inicializar la tabla bankroll
USER_TIMEZONE=America/Mexico_City    # define que es "hoy" y "manana"

# ── Kill-switch Mundial 2026 ─────────────────────────────────────────
# false = las predicciones del Mundial van a paper (data/paper_trades.jsonl,
# tag [PAPER] en Telegram) y NO tocan bets_history ni el bankroll.
WORLD_CUP_BETTING_ENABLED=false
